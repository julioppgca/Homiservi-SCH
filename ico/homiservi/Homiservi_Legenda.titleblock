<?xml version="1.0" encoding="UTF-8"?>
<titleblocktemplate name="Homiservi_Legenda">
            <information/>
            <logos>
                <logo name="logo.png" storage="base64" type="png"></logo>
            </logos>
            <grid cols="130px;100px;25px;50px;100px;25px;t22%;r100%;50px;" rows="11;11;11;11;11;11;">
