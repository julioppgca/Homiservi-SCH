<definition type="element" version="0.200.1" link_type="simple" hotspot_x="25" hotspot_y="60" width="540" height="150">
    <uuid uuid="{68fe578a-0bfd-47a2-8f8f-b3a88199af49}"/>
    <names>
        <name lang="en">Adaptador de bornes CB106 – cabo flat 50 vias</name>
        <name lang="fr">Adaptador de bornes CB106 – cabo flat 50 vias</name>
        <name lang="pt">Adaptador de bornes CB106 – cabo flat 50 vias</name>
        <name lang="pt_BR">Adaptador de bornes CB106 – cabo flat 50 vias</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Phoenix Contact</elementInformation>
        <elementInformation name="designation" show="1">VIP-3/SC/FLK50</elementInformation>
        <elementInformation name="description" show="1">Adaptador de bornes para o cabo flat do CB106 (I/O do armário FANUC)</elementInformation>
    </elementInformations>
    <informations>Homiservi-SCH: adaptador de bornes para cabo flat de 50 vias (como o Phoenix Contact VIP-3/SC/FLK50), ligado ao CB106 da unidade de I/O A02B-0319-C001. Pinagem do manual FANUC B-64693EN (8.12.3). Borne n = fio n do cabo flat: fio ímpar na fileira A, fio par na fileira B (A01 = 1, B01 = 2, A02 = 3...); confira com o adaptador usado. Os endereços X/Y vêm da base do módulo ligado pelo cabo flat (ou da base informada no próprio adaptador).</informations>
