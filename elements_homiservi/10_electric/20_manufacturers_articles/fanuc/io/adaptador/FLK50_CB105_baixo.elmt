<definition type="element" version="0.200.1" link_type="simple" hotspot_x="25" hotspot_y="10" width="540" height="140">
    <uuid uuid="{a7bb07c1-85a1-4684-ba30-4ef84d0ca3ed}"/>
    <names>
        <name lang="en">Adaptador de bornes CB105 – cabo flat 50 vias (fios por baixo)</name>
        <name lang="fr">Adaptador de bornes CB105 – cabo flat 50 vias (fios por baixo)</name>
        <name lang="pt">Adaptador de bornes CB105 – cabo flat 50 vias (fios por baixo)</name>
        <name lang="pt_BR">Adaptador de bornes CB105 – cabo flat 50 vias (fios por baixo)</name>
    </names>
    <elementInformations>
        <elementInformation name="manufacturer" show="1">Phoenix Contact</elementInformation>
        <elementInformation name="designation" show="1">VIP-3/SC/FLK50</elementInformation>
        <elementInformation name="description" show="1">Adaptador de bornes para o cabo flat do CB105 (I/O do armário FANUC)</elementInformation>
    </elementInformations>
    <informations>Homiservi-SCH: adaptador de bornes para cabo flat de 50 vias (como o Phoenix Contact VIP-3/SC/FLK50), ligado ao CB105 da unidade de I/O A02B-0319-C001. Pinagem do manual FANUC B-64693EN (8.12.3). Borne n = fio n do cabo flat: fio ímpar na fileira A, fio par na fileira B (A01 = 1, B01 = 2, A02 = 3...); confira com o adaptador usado. Os endereços X/Y vêm da base do módulo ligado pelo cabo flat (ou da base informada no próprio adaptador).</informations>
